# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore).

# Secreto para firmar los tokens JWT. Usa un valor largo y aleatorio.
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cadena de conexión a PostgreSQL (Neon).
DATABASE_URL=

# Orígenes permitidos para CORS, separados por comas (el dominio de tu frontend).
# Ejemplo: https://epigrafe-frontend.onrender.com
# Si se deja vacío, se permiten todos los orígenes (NO recomendado en producción).
CORS_ORIGINS=

# Puerto local (opcional; en Render lo asigna la plataforma).
PORT=3000

# Poner en "false" solo si la conexión TLS a la BD falla por una CA no estándar.
# DB_SSL_REJECT_UNAUTHORIZED=true
